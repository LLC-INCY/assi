{
  "identifier": "viewer-local",
  "description": "Isolated outgoing session windows. No hosting or access administration.",
  "windows": [
    "viewer-*"
  ],
  "permissions": [
    "allow-session-windows",
    "allow-session-window-open",
    "allow-session-window-focus",
    "allow-session-window-close",
    "allow-load-snapshot",
    "allow-recording-start",
    "allow-recording-chunk",
    "allow-recording-prepare-finish",
    "allow-recording-finish",
    "allow-recording-abort",
    "allow-session-system-snapshot",
    "allow-session-system-request",
    "allow-session-video",
    "allow-session-video-codec",
    "allow-session-video-keyframe",
    "allow-session-screen-ack",
    "allow-session-display",
    "allow-session-clipboard-send",
    "allow-session-clipboard-read",
    "allow-session-chat",
    "allow-session-chat-send",
    "allow-session-terminal-request",
    "allow-session-terminal-input",
    "allow-session-terminal-resize",
    "allow-session-terminal-read",
    "allow-session-terminal-close",
    "allow-session-snapshot",
    "allow-session-audio",
    "allow-session-save-image",
    "allow-session-annotations",
    "allow-session-annotate",
    "allow-session-fullscreen",
    "allow-session-connect",
    "allow-session-stop",
    "allow-session-frame",
    "allow-session-input",
    "allow-session-file-offer-folder",
    "allow-session-file-accept-folder",
    "allow-session-file-folder-status",
    "allow-session-file-pause",
    "allow-session-file-resume",
    "allow-session-file-offer",
    "allow-session-file-queue",
    "allow-session-file-queue-remove",
    "allow-session-file-accept",
    "allow-session-file-reject",
    "allow-session-file-cancel"
  ]
}
